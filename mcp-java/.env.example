# Vorlage für mcp-java/.env (wird von Docker Compose und vom Seed-Script gelesen).
# Die echte .env ist gitignoriert: cp .env.example .env
#
# Wird von docker-compose.yml ausgewertet.
OPEN_WEBUI_HOST_PORT=3001

# Admin-Konto dieser Instanz. Wird beim ersten Seed-Lauf angelegt; bei
# weiteren Läufen meldet sich das Script mit denselben Werten an.
OPENWEBUI_ADMIN_NAME=Admin
OPENWEBUI_ADMIN_EMAIL=admin@example.com
OPENWEBUI_ADMIN_PASSWORD=change-me

# Stabile Kennung dieser Open-WebUI-Instanz. Muss sich von anderen
# Installationen unterscheiden (wird für den XTF-Import-Schlüssel genutzt).
OPENWEBUI_INSTANCE_ID=datenblatt-openwebui

# Host-Port des direkt mit `java -jar` gestarteten Datenblatt-MCP.
# Open WebUI erreicht ihn über http://host.docker.internal:<Port>/mcp.
DATASHEET_MCP_PORT=8001

# Basismodell des Workspace-Modells «Datenblatt-Editor». Alternativen aus der
# Referenz-Konfiguration: moonshotai/Kimi-K2.6, swiss-ai/Apertus-v1.5-70B.
OPENWEBUI_MODEL_BASE=Qwen/Qwen3.5-397B-A17B-FP8

# API-Schlüssel der OpenAI-kompatiblen Provider (wie Agentic-BI-Demo).
INFOMANIAK_API_KEY=
DEEPSEEK_API_KEY=
